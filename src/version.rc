#include <winver.h>
#include "platform_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     PLATFORM_V1,PLATFORM_V2,PLATFORM_V3,0
 PRODUCTVERSION  PLATFORM_V1,PLATFORM_V2,PLATFORM_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Trinculo54"
            VALUE "FileDescription",  "FH2 Mod Platform (loads fh2-mods\\*.dll; forwards D3DCompiler and DirectWrite to System32)"
            VALUE "FileVersion",      PLATFORM_VERSION_STR
            VALUE "InternalName",     "FH2 Mod Platform"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "d3dcompiler_47.dll"
            VALUE "ProductName",      "FH2 Mod Platform"
            VALUE "ProductVersion",   PLATFORM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
